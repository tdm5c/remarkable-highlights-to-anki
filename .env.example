# Copy this file to .env.local and fill in your local values.
# Do not commit .env.local.

# Preferred: used to rediscover the reMarkable IP when DHCP changes it.
RM_REMARKABLE_MAC=

# Optional cache/override. The script may update this in .env.local.
RM_REMARKABLE_IP=

# Optional. If blank, the script will try SSH keys or prompt in interactive CLI.
RM_SSH_PASSWORD=

# Optional SSH settings.
RM_SSH_USER=root
RM_SSH_PORT=22

# Optional Anki settings.
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_EXE=C:\Program Files\Anki\Anki.exe
